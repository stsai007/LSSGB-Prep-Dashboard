        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;block-beta\n    columns 2\n\n    %% 頂部標題 (跨 2 欄)\n    TITLE[\&quot;&lt;b&gt;LSSGB 備考運營儀表板架構 (4 區塊 DMAIC 閉環模型)&lt;/b&gt;\&quot;]:2\n\n    %% =======================\n    %% [左上] 區塊 1\n    %% =======================\n    block:B1:1\n        columns 1\n        B1_HEADER[\&quot;&lt;b&gt;[左上] 區塊 1: 成果品質總覽 (Define/Measure - Y)&lt;/b&gt;\&quot;]\n        \n        %% Option Button 切換條 (內部拆 2 欄)\n        block:B1_BTNS:1\n            columns 2\n            BTN_OPT1[\&quot;🔘 [Active] Knowledge Mastery\&quot;]\n            BTN_OPT2[\&quot;⚪ Practice Exam\&quot;]\n        end\n\n        B1_CONTENT[\&quot;&lt;b&gt;當前數據視圖 (動態切換):&lt;/b&gt;&lt;br/&gt;• 信心指數 (Confidence Level ≥ 3)&lt;br/&gt;• 掌握度 (Satisfaction Rate ≥ 4)&lt;br/&gt;• 核心公式/小抄累計建置量\&quot;]\n    end\n\n    %% =======================\n    %% [右上] 區塊 2\n    %% =======================\n    block:B2:1\n        columns 1\n        B2_HEADER[\&quot;&lt;b&gt;[右上] 區塊 2: 流程效率與精益浪費 (Measure - X)&lt;/b&gt;\&quot;]\n        B2_VIS[\&quot;&lt;b&gt;視覺化:&lt;/b&gt; VA / NVA 堆疊條形圖 + 子彈圖\&quot;]\n        B2_METRICS[\&quot;&lt;b&gt;監控指標:&lt;/b&gt;&lt;br/&gt;• 每週實際工時 vs 規格界限 (USL 120 / LSL 60)&lt;br/&gt;• 製程循環效率 PCE = VA / (VA + NVA)&lt;br/&gt;• DOWNTIME 8 大浪費耗時佔比\&quot;]\n    end\n\n    %% =======================\n    %% [左下] 區塊 3\n    %% =======================\n    block:B3:1\n        columns 1\n        B3_HEADER[\&quot;&lt;b&gt;[左下] 區塊 3: 統計製程管制 (Control - 變異)&lt;/b&gt;\&quot;]\n        B3_VIS[\&quot;&lt;b&gt;視覺化:&lt;/b&gt; 單值移動全距管制圖 (I-MR Chart)\&quot;]\n        B3_METRICS[\&quot;&lt;b&gt;監控指標:&lt;/b&gt;&lt;br/&gt;• NVA 浪費時間/工時變異率管制圖&lt;br/&gt;• 自動標註 UCL、CL、LCL (±3σ 界限)&lt;br/&gt;• 超出 UCL 特殊原因 (Special Cause) 報警\&quot;]\n    end\n\n    %% =======================\n    %% [右下] 區塊 4\n    %% =======================\n    block:B4:1\n        columns 1\n        B4_HEADER[\&quot;&lt;b&gt;[右下] 區塊 4: 根因診斷與對策 (Analyze/Improve - 行動)&lt;/b&gt;\&quot;]\n        B4_VIS[\&quot;&