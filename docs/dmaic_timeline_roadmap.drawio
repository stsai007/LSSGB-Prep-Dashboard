        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef stage fill:#F1F5F9,stroke:#64748B,stroke-width:1.5px;\n    classDef core fill:#FFFFFF,stroke:#94A3B8,stroke-width:1px;\n    classDef keypoint fill:#EFF6FF,stroke:#3B82F6,stroke-width:1.5px;\n    classDef pass fill:#FEF3C7,stroke:#D97706,stroke-width:2px;\n\n    subgraph Phase1 [\&quot;【第一階段】學期平時儲備期（即日起 – 12月中旬｜每週 1–2 hrs）\&quot;]\n        direction TB\n        M10[\&quot;&lt;b&gt;10 月：工具與框架對齊&lt;/b&gt;&lt;br/&gt;• 教材定錨：下載 CSSC 手冊 / ASQ Handbook&lt;br/&gt;• &lt;b&gt;DMAIC 框架：&lt;/b&gt;Define (Charter/SIPOC/CTQ) + Measure (VSM)&lt;br/&gt;• 實務對照：工作流程梳理套入 SIPOC\&quot;]:::keypoint\n        M11[\&quot;&lt;b&gt;11 月：統計與分析複習&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Analyze 工具：&lt;/b&gt;8大浪費、魚骨圖、5 Whys、Pareto&lt;br/&gt;• &lt;b&gt;品管統計：&lt;/b&gt;常態分佈、假設檢定 (p-value, Type I/II)、製程能力 (Cp, Cpk)\&quot;]:::keypoint\n        M12[\&quot;&lt;b&gt;12 月上旬：改善控制與期末收尾&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Improve &amp; Control：&lt;/b&gt;防呆 (Poka-Yoke)、FMEA (RPN)、SPC 管制圖選擇&lt;br/&gt;• 專注研究所期末課業交付，暫不刷題\&quot;]:::core\n        \n        M10 --&gt; M11 --&gt; M12\n    end\n\n    subgraph Phase2 [\&quot;【第二階段】冬季衝刺與刷題期（12/20 – 01/10｜每週 10–15 hrs）\&quot;]\n        direction TB\n        W1[\&quot;&lt;b&gt;第 1 週 (12/20–12/27)：體系地毯式串聯&lt;/b&gt;&lt;br/&gt;• 精讀考綱筆記 / 線上衝刺課&lt;br/&gt;• 提煉個人「公式與管制圖判讀小抄」\&quot;]:::core\n        W2[\&quot;&lt;b&gt;第 2 週 (12/28–01/03)：題庫高強度演練&lt;/b&gt;&lt;br/&gt;• 每日 50–100 題（依 DMAIC 階段訂正錯題與統計盲點）&lt;br/&gt;• 註冊 PeopleCert/IASSC 帳號並預約 1 月場次\&quot;]:::keypoint\n        W3[\&quot;&lt;b&gt;第 3 週 (01/04–01/10)：全真模擬與應試&lt;/b&gt;&lt;br/&gt;• 1–2 次 3小時/100題全真計時（答對率穩定 ≥ 80%）\&quot;]:::core\n        PASS[\&quot;🏆 &lt;b&gt;正式參加線上考試，取得 LSSGB 認證&lt;/b&gt;\&quot;]:::pass\n\n        W1 --&gt; W2 --&gt; W3 --&gt; PASS\n    end\n\n    M12 ==&gt; W1&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Usfgp-9FF6Dvez-TIk3X-87">
