        <UserObject label="[Stage 1] Preparation (Effective Immediately – Dec | 1–2 hrs/week)" mermaidId="n:Phase1" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="【第一階段】學期平時儲備期（即日起 – 12月中旬｜每週 1–2 hrs）" id="Usfgp-9FF6Dvez-TIk3X-88">
